# Copia este archivo como .env (en la VM) y completa los valores.

# Seguridad
SECRET_KEY=cambia_esta_clave_por_una_larga_y_aleatoria
CODIGO_INVITACION=Hakuyomi2026

# URL pública del frontend (el enlace del correo apunta aquí)
FRONTEND_URL=http://localhost:5173

# --- Correo SMTP ---
# Gmail: activa la verificación en 2 pasos y crea una "Contraseña de aplicación"
# en https://myaccount.google.com/apppasswords ; úsala en SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=tu_correo@gmail.com
# (los 16 caracteres de la contraseña de aplicación, sin espacios)
SMTP_PASSWORD=abcdefghijklmnop
SMTP_FROM=Simulador Topcon ES-105 <tu_correo@gmail.com>

# Vigencia del enlace de recuperación (minutos)
RESET_TOKEN_EXPIRE_MINUTES=30
